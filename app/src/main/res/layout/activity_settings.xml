<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp">
            <FrameLayout
                android:id="@+id/btn_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_green_light"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/boop_green" />
            </FrameLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil y ajustes"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/text_primary_light"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Tarjeta Usuario Verde -->
        <androidx.cardview.widget.CardView
            android:id="@+id/profile_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/boop_green">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">
                <FrameLayout
                    android:id="@+id/avatar_container"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_avatar_card"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="👦"
                        android:textSize="26sp" />
                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_circle_green"
                        android:text="+"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_bold" />
                </FrameLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/avatar_container"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Narcís Torres"
                        android:textSize="18sp"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="@color/white" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="narcis@boop.app"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="#CCFFFFFF" />
                </LinearLayout>
                <ImageView
                    android:id="@+id/btn_edit_profile"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_edit"
                    android:background="@drawable/bg_pill_orange"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/white" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- Sección: Mis Mascotas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MIS MASCOTAS"
            android:textSize="11sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/text_tertiary_light"
            android:paddingStart="24dp"
            android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/row_pet_mochi"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="16dp" android:gravity="center_vertical"
                    android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp"
                        android:src="@drawable/ic_cat" android:background="@drawable/bg_circle_green_light"
                        android:padding="8dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Mochi" android:fontFamily="@font/poppins_bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Gata europea · 3 años" android:textSize="11sp" android:textColor="@color/text_secondary_light" />
                    </LinearLayout>
                    <ImageView android:id="@+id/btn_delete_mochi" android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_trash" app:tint="@color/alert_red" android:clickable="true" android:focusable="true" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_light" android:layout_marginHorizontal="16dp" />
                <LinearLayout
                    android:id="@+id/row_pet_max"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="16dp" android:gravity="center_vertical"
                    android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp"
                        android:src="@drawable/ic_dog" android:background="@drawable/bg_circle_green_light"
                        android:padding="8dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Max" android:fontFamily="@font/poppins_bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Golden Retriever · 5 años" android:textSize="11sp" android:textColor="@color/text_secondary_light" />
                    </LinearLayout>
                    <ImageView android:id="@+id/btn_delete_max" android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_trash" app:tint="@color/alert_red" android:clickable="true" android:focusable="true" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_light" android:layout_marginHorizontal="16dp" />
                <LinearLayout
                    android:id="@+id/row_guardians"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="16dp" android:gravity="center_vertical"
                    android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp"
                        android:src="@drawable/ic_nav_profile" android:background="@drawable/bg_ico_blue"
                        android:padding="8dp" app:tint="#6366F1" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:text="Cuidadores" android:fontFamily="@font/poppins_bold" />
                    <ImageView android:layout_width="16dp" android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right" app:tint="@color/text_tertiary_light" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_light" android:layout_marginHorizontal="16dp" />
                <LinearLayout
                    android:id="@+id/row_add_pet"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="16dp" android:gravity="center_vertical"
                    android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp"
                        android:src="@drawable/ic_plus" android:background="@drawable/bg_circle_dashed_green"
                        android:padding="10dp" app:tint="@color/boop_green" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Añadir mascota" android:layout_marginStart="12dp"
                        android:fontFamily="@font/poppins_semibold" android:textColor="@color/boop_green" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Sección: Notificaciones -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="NOTIFICACIONES" android:textSize="11sp" android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/text_tertiary_light" android:paddingStart="24dp" android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp" android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/white">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="16dp" android:gravity="center_vertical">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp"
                        android:src="@drawable/ic_bell" android:background="@drawable/bg_ico_orange"
                        android:padding="8dp" app:tint="#F59E0B" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Alertas de salud" android:fontFamily="@font/poppins_bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Vacunas, medicación, citas" android:textSize="11sp" android:textColor="@color/text_secondary_light" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_notifications_health"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_light" android:layout_marginHorizontal="16dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="16dp" android:gravity="center_vertical">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp"
                        android:src="@drawable/ic_nav_community" android:background="@drawable/bg_ico_green"
                        android:padding="8dp" app:tint="@color/boop_green" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Comunidad" android:fontFamily="@font/poppins_bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Respuestas y menciones" android:textSize="11sp" android:textColor="@color/text_secondary_light" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_notifications_community"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Apariencia -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="APARIENCIA" android:textSize="11sp" android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/text_tertiary_light" android:paddingStart="24dp" android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp" android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/white">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/row_theme_system" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="16dp" android:gravity="center_vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                    <View android:id="@+id/radio_system" android:layout_width="20dp" android:layout_height="20dp"
                        android:background="@drawable/bg_radio_active" android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Seguir sistema" android:fontFamily="@font/poppins_bold" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_light" android:layout_marginHorizontal="16dp" />
                <LinearLayout android:id="@+id/row_theme_light" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="16dp" android:gravity="center_vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                    <View android:id="@+id/radio_light" android:layout_width="20dp" android:layout_height="20dp"
                        android:background="@drawable/bg_radio_inactive" android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Modo claro" android:fontFamily="@font/poppins_bold" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_light" android:layout_marginHorizontal="16dp" />
                <LinearLayout android:id="@+id/row_theme_dark" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="16dp" android:gravity="center_vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                    <View android:id="@+id/radio_dark" android:layout_width="20dp" android:layout_height="20dp"
                        android:background="@drawable/bg_radio_inactive" android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Modo oscuro" android:fontFamily="@font/poppins_bold" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Privacidad y Cuenta -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="PRIVACIDAD Y CUENTA" android:textSize="11sp" android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/text_tertiary_light" android:paddingStart="24dp" android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp" android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/white">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/row_privacy" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="16dp" android:gravity="center_vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp"
                        android:src="@drawable/ic_lock" android:background="@drawable/bg_ico_blue"
                        android:padding="8dp" app:tint="#6366F1" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:text="Privacidad de datos" android:fontFamily="@font/poppins_bold" />
                    <ImageView android:layout_width="16dp" android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right" app:tint="@color/text_tertiary_light" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_light" android:layout_marginHorizontal="16dp" />
                <LinearLayout android:id="@+id/row_terms" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="16dp" android:gravity="center_vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp"
                        android:src="@drawable/ic_document" android:background="@drawable/bg_ico_blue"
                        android:padding="8dp" app:tint="#6366F1" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:text="Términos y condiciones" android:fontFamily="@font/poppins_bold" />
                    <ImageView android:layout_width="16dp" android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right" app:tint="@color/text_tertiary_light" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Cerrar sesión -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btn_logout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/white">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="16dp" android:gravity="center_vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_logout" app:tint="@color/alert_red" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Cerrar sesión" android:layout_marginStart="12dp"
                    android:fontFamily="@font/poppins_bold" android:textColor="@color/alert_red" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
