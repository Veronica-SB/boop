<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <!-- colorSurface cambia automáticamente con DayNight -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- ── HEADER ───────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:background="?attr/colorSurface">

            <FrameLayout
                android:id="@+id/btn_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_green_light"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/boop_green" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Perfil y ajustes"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Divider bajo el header -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_light" />

        <!-- ── TARJETA DE USUARIO (verde) ──────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:id="@+id/profile_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/boop_green">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="22dp">

                <!-- Avatar -->
                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_avatar_card"
                    android:layout_marginEnd="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="🧑"
                        android:textSize="28sp" />
                </FrameLayout>

                <!-- Nombre + email -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Narcís Garcia"
                        android:textSize="20sp"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="@color/white" />
                    <TextView
                        android:id="@+id/tv_user_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="narcis@boop.app"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="#BDFFFFFF"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <!-- Edit button -->
                <FrameLayout
                    android:id="@+id/btn_edit_profile"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_edit_btn_card"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/white" />
                </FrameLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── SECCIÓN: MIS MASCOTAS ────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mis mascotas"
            android:textSize="11sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/text_tertiary_light"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:paddingStart="28dp"
            android:paddingBottom="10dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Mascota 1 -->
                <LinearLayout
                    android:id="@+id/row_pet_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="15dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_ico_green"
                        android:layout_marginEnd="14dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:layout_gravity="center" android:src="@drawable/ic_cat"
                            app:tint="@color/boop_green" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Mochi" android:textSize="14sp"
                            android:fontFamily="@font/poppins_semibold" android:textColor="?attr/colorOnSurface" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Gata europea · 3 años" android:textSize="12sp"
                            android:fontFamily="@font/poppins_regular" android:textColor="@color/text_secondary_light"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                    <FrameLayout
                        android:id="@+id/btn_delete_pet_1"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_ico_red"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_trash"
                            app:tint="@color/alert_red" />
                    </FrameLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border_light" android:layout_marginStart="18dp" />

                <!-- Mascota 2 -->
                <LinearLayout
                    android:id="@+id/row_pet_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="15dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_ico_green"
                        android:layout_marginEnd="14dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:layout_gravity="center" android:src="@drawable/ic_dog"
                            app:tint="@color/boop_green" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Tofu" android:textSize="14sp"
                            android:fontFamily="@font/poppins_semibold" android:textColor="?attr/colorOnSurface" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Golden Retriever · 5 años" android:textSize="12sp"
                            android:fontFamily="@font/poppins_regular" android:textColor="@color/text_secondary_light"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                    <FrameLayout
                        android:id="@+id/btn_delete_pet_2"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_ico_red"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_trash"
                            app:tint="@color/alert_red" />
                    </FrameLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border_light" android:layout_marginStart="18dp" />

                <!-- Añadir mascota -->
                <LinearLayout
                    android:id="@+id/row_add_pet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="15dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_ico_gray"
                        android:layout_marginEnd="14dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:layout_gravity="center" android:src="@drawable/ic_plus"
                            app:tint="@color/text_secondary_light" />
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Añadir mascota" android:textSize="14sp"
                        android:fontFamily="@font/poppins_semibold" android:textColor="@color/boop_green" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── SECCIÓN: NOTIFICACIONES ──────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notificaciones"
            android:textSize="11sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/text_tertiary_light"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:paddingStart="28dp"
            android:paddingBottom="10dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Alertas de salud — toggle ON -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:padding="15dp">
                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                        android:background="@drawable/bg_ico_orange" android:layout_marginEnd="14dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:layout_gravity="center" android:src="@drawable/ic_bell"
                            app:tint="#F59E0B" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Alertas de salud" android:textSize="14sp"
                            android:fontFamily="@font/poppins_semibold" android:textColor="?attr/colorOnSurface" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Vacunas, medicación, citas" android:textSize="12sp"
                            android:fontFamily="@font/poppins_regular" android:textColor="@color/text_secondary_light"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                    <View android:id="@+id/toggle_health"
                        android:layout_width="44dp" android:layout_height="26dp"
                        android:background="@drawable/bg_toggle_on"
                        android:clickable="true" android:focusable="true" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border_light" android:layout_marginStart="18dp" />

                <!-- Comunidad — toggle ON -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:padding="15dp">
                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                        android:background="@drawable/bg_ico_orange" android:layout_marginEnd="14dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:layout_gravity="center" android:src="@drawable/ic_nav_community"
                            app:tint="#F59E0B" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Comunidad" android:textSize="14sp"
                            android:fontFamily="@font/poppins_semibold" android:textColor="?attr/colorOnSurface" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Respuestas y menciones" android:textSize="12sp"
                            android:fontFamily="@font/poppins_regular" android:textColor="@color/text_secondary_light"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                    <View android:id="@+id/toggle_community"
                        android:layout_width="44dp" android:layout_height="26dp"
                        android:background="@drawable/bg_toggle_on"
                        android:clickable="true" android:focusable="true" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border_light" android:layout_marginStart="18dp" />

                <!-- Mensajes — toggle OFF -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:padding="15dp">
                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                        android:background="@drawable/bg_ico_orange" android:layout_marginEnd="14dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:layout_gravity="center" android:src="@drawable/ic_message"
                            app:tint="#F59E0B" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Mensajes" android:textSize="14sp"
                            android:fontFamily="@font/poppins_semibold" android:textColor="?attr/colorOnSurface" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Nuevos mensajes directos" android:textSize="12sp"
                            android:fontFamily="@font/poppins_regular" android:textColor="@color/text_secondary_light"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                    <View android:id="@+id/toggle_messages"
                        android:layout_width="44dp" android:layout_height="26dp"
                        android:background="@drawable/bg_toggle_off"
                        android:clickable="true" android:focusable="true" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── SECCIÓN: APARIENCIA (modo oscuro/claro/sistema) ─────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apariencia"
            android:textSize="11sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/text_tertiary_light"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:paddingStart="28dp"
            android:paddingBottom="10dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Opción: Seguir sistema -->
                <LinearLayout
                    android:id="@+id/opt_theme_system"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <View
                        android:id="@+id/radio_system"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_radio_active" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Seguir sistema" android:textSize="14sp"
                            android:fontFamily="@font/poppins_semibold" android:textColor="?attr/colorOnSurface" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Se adapta al ajuste del móvil" android:textSize="12sp"
                            android:fontFamily="@font/poppins_regular" android:textColor="@color/text_secondary_light"
                            android:layout_marginTop="1dp" />
                    </LinearLayout>
                    <!-- Preview: mitad clara / mitad oscura -->
                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="24dp"
                        android:gravity="center"
                        android:text="A"
                        android:textSize="10sp"
                        android:fontFamily="@font/poppins_bold"
                        android:background="@drawable/bg_preview_auto"
                        android:textColor="@color/text_primary_light" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border_light" android:layout_marginStart="18dp" />

                <!-- Opción: Modo claro -->
                <LinearLayout
                    android:id="@+id/opt_theme_light"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <View
                        android:id="@+id/radio_light"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_radio_inactive" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Modo claro" android:textSize="14sp"
                            android:fontFamily="@font/poppins_semibold" android:textColor="?attr/colorOnSurface" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Siempre fondo blanco" android:textSize="12sp"
                            android:fontFamily="@font/poppins_regular" android:textColor="@color/text_secondary_light"
                            android:layout_marginTop="1dp" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="24dp"
                        android:gravity="center"
                        android:text="☀"
                        android:textSize="12sp"
                        android:background="@drawable/bg_preview_light" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border_light" android:layout_marginStart="18dp" />

                <!-- Opción: Modo oscuro -->
                <LinearLayout
                    android:id="@+id/opt_theme_dark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <View
                        android:id="@+id/radio_dark"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_radio_inactive" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Modo oscuro" android:textSize="14sp"
                            android:fontFamily="@font/poppins_semibold" android:textColor="?attr/colorOnSurface" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Ahorra batería en OLED" android:textSize="12sp"
                            android:fontFamily="@font/poppins_regular" android:textColor="@color/text_secondary_light"
                            android:layout_marginTop="1dp" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="24dp"
                        android:gravity="center"
                        android:text="🌙"
                        android:textSize="12sp"
                        android:background="@drawable/bg_preview_dark" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── SECCIÓN: PRIVACIDAD Y CUENTA ────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Privacidad y cuenta"
            android:textSize="11sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/text_tertiary_light"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:paddingStart="28dp"
            android:paddingBottom="10dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <!-- Privacidad de datos -->
                <LinearLayout android:id="@+id/row_privacy"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:padding="15dp" android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                        android:background="@drawable/bg_ico_blue" android:layout_marginEnd="14dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:layout_gravity="center" android:src="@drawable/ic_lock"
                            app:tint="#6366F1" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Privacidad de datos" android:textSize="14sp"
                            android:fontFamily="@font/poppins_semibold" android:textColor="?attr/colorOnSurface" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="RGPD · Permisos" android:textSize="12sp"
                            android:fontFamily="@font/poppins_regular" android:textColor="@color/text_secondary_light"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                    <ImageView android:layout_width="16dp" android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right" app:tint="@color/text_tertiary_light" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border_light" android:layout_marginStart="18dp" />

                <!-- Términos -->
                <LinearLayout android:id="@+id/row_terms"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:padding="15dp" android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                        android:background="@drawable/bg_ico_blue" android:layout_marginEnd="14dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:layout_gravity="center" android:src="@drawable/ic_document"
                            app:tint="#6366F1" />
                    </FrameLayout>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Términos y condiciones" android:textSize="14sp"
                        android:fontFamily="@font/poppins_semibold" android:textColor="?attr/colorOnSurface" />
                    <ImageView android:layout_width="16dp" android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right" app:tint="@color/text_tertiary_light" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border_light" android:layout_marginStart="18dp" />

                <!-- Política -->
                <LinearLayout android:id="@+id/row_policy"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:padding="15dp" android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                        android:background="@drawable/bg_ico_blue" android:layout_marginEnd="14dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:layout_gravity="center" android:src="@drawable/ic_info"
                            app:tint="#6366F1" />
                    </FrameLayout>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Política de privacidad" android:textSize="14sp"
                        android:fontFamily="@font/poppins_semibold" android:textColor="?attr/colorOnSurface" />
                    <ImageView android:layout_width="16dp" android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right" app:tint="@color/text_tertiary_light" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── SECCIÓN: CERRAR SESIÓN ───────────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout
                android:id="@+id/row_logout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                    android:background="@drawable/bg_ico_red" android:layout_marginEnd="14dp">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:layout_gravity="center" android:src="@drawable/ic_logout"
                        app:tint="@color/alert_red" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Cerrar sesión" android:textSize="14sp"
                    android:fontFamily="@font/poppins_semibold" android:textColor="@color/alert_red" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Versión -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BOOP v1.0.0 · DAM Grupo 13 · 2026"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/text_tertiary_light"
            android:gravity="center"
            android:padding="24dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
