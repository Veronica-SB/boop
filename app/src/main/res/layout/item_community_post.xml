<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Post header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="13dp"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_circle_green_light"
                android:layout_marginEnd="10dp">
                <ImageView
                    android:id="@+id/iv_user_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_cat"
                    android:scaleType="centerInside" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Usuario"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/text_primary_light" />
                <TextView
                    android:id="@+id/tv_post_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hace un momento"
                    android:textSize="11sp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/text_tertiary_light" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_post_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❓ Pregunta"
                android:textSize="10sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="#E65100"
                android:background="@drawable/bg_pill_orange_light"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <!-- Post body -->
        <TextView
            android:id="@+id/tv_post_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contenido del mensaje..."
            android:textSize="13sp"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/text_primary_light"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingBottom="12dp"
            android:lineSpacingMultiplier="1.4" />

        <!-- Additional info (optional) -->
        <TextView
            android:id="@+id/tv_post_extra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Ubicación"
            android:textSize="11sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/boop_green_dark"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingBottom="12dp"
            android:visibility="gone" />

        <!-- Post actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/bg_border_top">
            <TextView
                android:id="@+id/tv_comments_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬 0"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/text_secondary_light"
                android:layout_marginEnd="16dp" />
            <TextView
                android:id="@+id/tv_likes_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❤️ 0"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/alert_red" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
