<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Contenedor de Fragments (Navigation Component) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Bottom Navigation personalizada (5 tabs con FAB central) -->
    <LinearLayout
        android:id="@+id/bottom_nav_container"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom"
        android:background="@color/surface_light"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Inicio -->
        <LinearLayout
            android:id="@+id/nav_btn_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:id="@+id/nav_icon_home"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/boop_green" />
            <TextView
                android:id="@+id/nav_label_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_home"
                android:textSize="10sp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/boop_green"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Mapa -->
        <LinearLayout
            android:id="@+id/nav_btn_map"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:id="@+id/nav_icon_map"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_map"
                app:tint="@color/text_tertiary_light" />
            <TextView
                android:id="@+id/nav_label_map"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_map"
                android:textSize="10sp"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_tertiary_light"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- FAB central -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/nav_fab"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_add"
                android:contentDescription="Añadir"
                app:backgroundTint="@color/boop_green"
                app:tint="@color/white"
                app:fabSize="mini"
                app:elevation="4dp" />
        </FrameLayout>

        <!-- Comunidad -->
        <LinearLayout
            android:id="@+id/nav_btn_community"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:id="@+id/nav_icon_community"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_community"
                app:tint="@color/text_tertiary_light" />
            <TextView
                android:id="@+id/nav_label_community"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_community"
                android:textSize="10sp"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_tertiary_light"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Perfil -->
        <LinearLayout
            android:id="@+id/nav_btn_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:id="@+id/nav_icon_profile"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_profile"
                app:tint="@color/text_tertiary_light" />
            <TextView
                android:id="@+id/nav_label_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_profile"
                android:textSize="10sp"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_tertiary_light"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
