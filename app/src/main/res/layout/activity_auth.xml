<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Logo area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/boop_green">

            <ImageView
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:src="@drawable/logo_boop"
                app:tint="@android:color/white"
                android:scaleType="centerInside" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cero dramas, 100% mimos"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_light"
                android:textColor="#CCFFFFFF"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- White card area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_auth_card"
            android:layout_marginTop="-20dp"
            android:paddingTop="28dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">

            <!-- Login / Registro tabs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_tab_group"
                android:layout_marginBottom="28dp"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tab_login"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Entrar"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_tab_selected"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tab_register"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Registrarse"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/text_secondary_light"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Name field (only for Register) -->
            <LinearLayout
                android:id="@+id/layout_name_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre completo"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/text_primary_light"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:hintEnabled="false"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/border_light"
                    app:boxBackgroundColor="@color/background_light"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_name"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="Tu nombre"
                        android:inputType="textPersonName"
                        android:fontFamily="@font/poppins_regular"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary_light" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Email field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Correo electrónico"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/text_primary_light"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:hintEnabled="false"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/border_light"
                app:boxBackgroundColor="@color/background_light"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_email"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="tu@email.com"
                    android:inputType="textEmailAddress"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary_light" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contraseña"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/text_primary_light"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:hintEnabled="false"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/border_light"
                app:boxBackgroundColor="@color/background_light"
                app:endIconMode="password_toggle"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Mínimo 8 caracteres"
                    android:inputType="textPassword"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary_light" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Forgot password -->
            <TextView
                android:id="@+id/tv_forgot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="¿Olvidaste tu contraseña?"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/boop_green"
                android:layout_marginBottom="28dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Main CTA button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_auth_submit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Entrar"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/white"
                app:backgroundTint="@color/boop_green"
                app:cornerRadius="20dp"
                app:elevation="6dp"
                android:layout_marginBottom="20dp" />

            <!-- Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">
                <View android:layout_width="0dp" android:layout_height="1dp"
                    android:layout_weight="1" android:background="@color/border_light" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  o continúa con  "
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/text_tertiary_light" />
                <View android:layout_width="0dp" android:layout_height="1dp"
                    android:layout_weight="1" android:background="@color/border_light" />
            </LinearLayout>

            <!-- Google button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_google"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="   Continuar con Google"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/text_primary_light"
                app:backgroundTint="@color/surface_light"
                app:strokeColor="@color/border_light"
                app:strokeWidth="1dp"
                app:cornerRadius="20dp"
                app:elevation="0dp"
                android:layout_marginBottom="28dp" />

            <!-- Terms footer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Al continuar aceptas los Términos de uso y la Política de privacidad de BOOP."
                android:textSize="11sp"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_tertiary_light"
                android:gravity="center"
                android:lineSpacingMultiplier="1.4" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
