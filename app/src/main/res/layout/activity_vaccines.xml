<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp">
            <FrameLayout android:id="@+id/btn_back" android:layout_width="36dp" android:layout_height="36dp"
                android:background="@drawable/bg_circle_green_light">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back" app:tint="@color/boop_green" />
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Vacunas" android:textSize="18sp" android:fontFamily="@font/poppins_bold"
                android:textColor="@color/text_primary_light" android:layout_marginStart="12dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Mochi" android:textSize="12sp" android:textColor="@color/text_tertiary_light"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Lista de vacunas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- Antirrábica (Vencida) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:gravity="center_vertical">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp"
                        android:src="@drawable/ic_vaccine" android:background="@drawable/bg_circle_green_light"
                        android:padding="8dp" app:tint="@color/boop_green" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Antirrábica" android:fontFamily="@font/poppins_bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15 mar 2023 · Próxima: 15 mar 2024" android:textSize="10sp" android:textColor="@color/text_secondary_light" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vencida" android:textSize="10sp"
                        android:textColor="@color/white" android:background="@drawable/bg_pill_red" android:paddingHorizontal="8dp" android:paddingVertical="3dp" android:fontFamily="@font/poppins_bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Panleucopenia (Próxima) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:gravity="center_vertical">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp"
                        android:src="@drawable/ic_vaccine" android:background="@drawable/bg_ico_orange"
                        android:padding="8dp" app:tint="#F59E0B" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Panleucopenia" android:fontFamily="@font/poppins_bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10 ene 2025 · Próxima: 10 ene 2026" android:textSize="10sp" android:textColor="@color/text_secondary_light" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Próxima" android:textSize="10sp"
                        android:textColor="@color/alert_yellow_text" android:background="@drawable/bg_pill_yellow" android:paddingHorizontal="8dp" android:paddingVertical="3dp" android:fontFamily="@font/poppins_bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Calicivirus (Al día) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:gravity="center_vertical">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp"
                        android:src="@drawable/ic_vaccine" android:background="@drawable/bg_circle_green_light"
                        android:padding="8dp" app:tint="@color/boop_green" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Calicivirus" android:fontFamily="@font/poppins_bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10 ene 2025 · Próxima: 10 ene 2026" android:textSize="10sp" android:textColor="@color/text_secondary_light" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Al día ✓" android:textSize="10sp"
                        android:textColor="@color/boop_green_dark" android:background="@drawable/bg_pill_green" android:paddingHorizontal="8dp" android:paddingVertical="3dp" android:fontFamily="@font/poppins_bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_register_vaccine"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="24dp"
            android:text="+ Registrar vacuna"
            android:fontFamily="@font/poppins_bold"
            app:backgroundTint="@color/boop_green"
            app:cornerRadius="16dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
