<?xml version="1.0" encoding="utf-8"?>
<!-- Historial médico: Añadir visita -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light"
    android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingBottom="40dp">

        <!-- Header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="24dp" android:paddingEnd="24dp"
            android:paddingTop="18dp" android:paddingBottom="18dp"
            android:background="@color/surface_light">
            <FrameLayout android:id="@+id/btn_back" android:layout_width="36dp" android:layout_height="36dp"
                android:background="@drawable/bg_circle_green_light" android:clickable="true"
                android:focusable="true" android:layout_marginEnd="12dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:layout_gravity="center" android:src="@drawable/ic_arrow_back"
                    app:tint="@color/boop_green" />
            </FrameLayout>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Añadir visita"
                android:textSize="17sp" android:fontFamily="@font/poppins_bold"
                android:textColor="@color/text_primary_light" />
        </LinearLayout>

        <!-- Form body -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="28dp" android:paddingEnd="28dp"
            android:paddingTop="8dp">

            <!-- Tipo de visita * -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Tipo de visita" android:textSize="13sp"
                    android:fontFamily="@font/poppins_semibold" android:textColor="@color/text_primary_light" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text=" *" android:textSize="13sp" android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/alert_red" />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="16dp"
                app:boxCornerRadiusBottomEnd="12dp" app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/border_light" app:boxBackgroundColor="@color/background_light"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_visit_type"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:hint="Revisión, Vacuna, Análisis…"
                    android:fontFamily="@font/poppins_regular" android:textSize="14sp"
                    android:textColor="@color/text_primary_light" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Clínica -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Clínica / Veterinario" android:textSize="13sp"
                android:fontFamily="@font/poppins_semibold" android:textColor="@color/text_primary_light"
                android:layout_marginBottom="8dp" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="16dp"
                app:boxCornerRadiusBottomEnd="12dp" app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/border_light" app:boxBackgroundColor="@color/background_light"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_visit_clinic"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:hint="Clínica Bau · Dr. López"
                    android:fontFamily="@font/poppins_regular" android:textSize="14sp"
                    android:textColor="@color/text_primary_light" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Fecha * -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Fecha" android:textSize="13sp" android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/text_primary_light" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text=" *" android:textSize="13sp" android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/alert_red" />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="16dp"
                app:boxCornerRadiusBottomEnd="12dp" app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/border_light" app:boxBackgroundColor="@color/background_light"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_visit_date"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:hint="DD/MM/AAAA" android:fontFamily="@font/poppins_regular"
                    android:textSize="14sp" android:inputType="date"
                    android:textColor="@color/text_primary_light" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Descripción (multiline) -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Descripción / Notas" android:textSize="13sp"
                android:fontFamily="@font/poppins_semibold" android:textColor="@color/text_primary_light"
                android:layout_marginBottom="8dp" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="28dp"
                app:boxCornerRadiusBottomEnd="12dp" app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/border_light" app:boxBackgroundColor="@color/background_light"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_visit_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="4"
                    android:maxLines="8"
                    android:hint="Diagnóstico, tratamiento, observaciones del veterinario…"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary_light"
                    android:inputType="textMultiLine|textCapSentences"
                    android:gravity="top|start"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Guardar -->
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_save_visit"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:text="Guardar visita" android:textSize="15sp"
                android:fontFamily="@font/poppins_bold" android:textColor="@color/white"
                app:backgroundTint="@color/boop_green" app:cornerRadius="20dp" app:elevation="6dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
