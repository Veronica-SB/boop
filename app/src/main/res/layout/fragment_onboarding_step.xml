<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_light">

    <!-- Top bar: paso X de 3 + Omitir -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_step_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1 de 3"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/text_tertiary_light" />

        <TextView
            android:id="@+id/tv_skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Omitir"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/text_tertiary_light"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Ilustración central -->
    <FrameLayout
        android:id="@+id/ob_illustration_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:paddingTop="24dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- Círculo de fondo con ilustración -->
        <FrameLayout
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_green_light">

            <ImageView
                android:id="@+id/ob_illustration"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_dog"
                android:scaleType="centerInside" />
        </FrameLayout>

    </FrameLayout>

    <!-- Bottom section: dots + título + texto + botón -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="48dp"
        android:paddingTop="8dp">

        <!-- Progress dots -->
        <LinearLayout
            android:id="@+id/ob_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_marginBottom="28dp">

            <View
                android:id="@+id/dot1"
                android:layout_width="24dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_ob_dot_active"
                android:layout_marginEnd="6dp" />
            <View
                android:id="@+id/dot2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_ob_dot_inactive"
                android:layout_marginEnd="6dp" />
            <View
                android:id="@+id/dot3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_ob_dot_inactive" />
        </LinearLayout>

        <!-- Título -->
        <TextView
            android:id="@+id/ob_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Todo sobre tu mascota en un lugar"
            android:textSize="22sp"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/text_primary_light"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginBottom="12dp" />

        <!-- Subtítulo -->
        <TextView
            android:id="@+id/ob_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chip, vacunas, historial médico, alergias… centralizado y siempre a mano desde tu móvil."
            android:textSize="14sp"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/text_secondary_light"
            android:gravity="center"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginBottom="32dp" />

        <!-- Botón siguiente -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_next"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Siguiente →"
            android:textSize="15sp"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/white"
            app:backgroundTint="@color/boop_green"
            app:cornerRadius="20dp"
            app:elevation="6dp" />

    </LinearLayout>
</LinearLayout>
