<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Header con back -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:background="@color/surface_light">

            <FrameLayout
                android:id="@+id/btn_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_green_light"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="12dp">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/boop_green" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Añade tu primera mascota"
                android:textSize="17sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/text_primary_light" />
        </LinearLayout>

        <!-- Hint -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Siempre podrás editar esto después."
            android:textSize="13sp"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/text_secondary_light"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingBottom="20dp" />

        <!-- Photo upload -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Foto"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/text_primary_light"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:id="@+id/btn_photo_upload"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:background="@drawable/bg_photo_upload"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/text_tertiary_light"
                        android:layout_marginBottom="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Añadir foto"
                        android:textSize="10sp"
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="@color/text_tertiary_light" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Name field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/text_primary_light"
                android:layout_marginBottom="8dp" />
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/boop_green"
                app:boxBackgroundColor="@color/boop_green_light"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_pet_name"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Mochi"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary_light" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Species selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo de animal"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/text_primary_light"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Gato (selected) -->
                <LinearLayout
                    android:id="@+id/btn_species_cat"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_species_btn_active"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_cat"
                        android:scaleType="centerInside"
                        app:tint="@color/boop_green" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gato"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="@color/boop_green_dark"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Perro -->
                <LinearLayout
                    android:id="@+id/btn_species_dog"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_species_btn_inactive"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_dog"
                        android:scaleType="centerInside"
                        app:tint="@color/text_secondary_light" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Perro"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="@color/text_secondary_light"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Conejo -->
                <LinearLayout
                    android:id="@+id/btn_species_rabbit"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_species_btn_inactive"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_rabbit"
                        android:scaleType="centerInside"
                        app:tint="@color/text_secondary_light" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Conejo"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="@color/text_secondary_light"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Otro -->
                <LinearLayout
                    android:id="@+id/btn_species_bird"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_species_btn_inactive"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="···"
                        android:textSize="20sp"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="@color/text_secondary_light" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Otro"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="@color/text_secondary_light"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- Breed + Sex row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Raza" android:textSize="13sp" android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/text_primary_light" android:layout_marginBottom="8dp" />
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    app:boxCornerRadiusBottomEnd="12dp" app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/border_light" app:boxBackgroundColor="@color/background_light"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_breed"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:hint="Europea" android:fontFamily="@font/poppins_regular"
                        android:textSize="14sp" android:textColor="@color/text_primary_light" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Sexo" android:textSize="13sp" android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/text_primary_light" android:layout_marginBottom="8dp" />
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    app:boxCornerRadiusBottomEnd="12dp" app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/border_light" app:boxBackgroundColor="@color/background_light"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_sex"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:hint="Hembra" android:fontFamily="@font/poppins_regular"
                        android:textSize="14sp" android:textColor="@color/text_primary_light" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Birth date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:layout_marginBottom="28dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Fecha de nacimiento" android:textSize="13sp"
                android:fontFamily="@font/poppins_semibold" android:textColor="@color/text_primary_light"
                android:layout_marginBottom="8dp" />
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:boxCornerRadiusBottomEnd="12dp" app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/border_light" app:boxBackgroundColor="@color/background_light"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_birthdate"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:hint="DD/MM/AAAA" android:fontFamily="@font/poppins_regular"
                    android:textSize="14sp" android:textColor="@color/text_primary_light"
                    android:inputType="date" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Submit button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_create_pet"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:text="Crear perfil de mascota"
            android:textSize="15sp"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/white"
            app:backgroundTint="@color/boop_green"
            app:cornerRadius="20dp"
            app:elevation="6dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
