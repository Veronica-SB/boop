<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/alerts_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_light"
        android:orientation="horizontal"
        android:padding="24dp"
        android:gravity="center_vertical"
        app:layout_anchor="@id/alerts_scroll"
        app:layout_anchorGravity="top">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Recordatorios"
            android:textSize="20sp"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/text_primary_light" />

        <FrameLayout
            android:id="@+id/btn_new_alert"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_green_light"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_plus"
                app:tint="@color/boop_green" />
        </FrameLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/alerts_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="84dp"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- ── SECCIÓN: RECORDATORIOS ──────────────────────────────────── -->
            <TextView
                android:id="@+id/tv_section_urgent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Urgentes"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/text_tertiary_light"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/container_urgent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_section_upcoming"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Próximas"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/text_tertiary_light"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/container_upcoming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_section_scheduled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Al día"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/text_tertiary_light"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/container_scheduled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Botón nuevo recordatorio -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create_alert"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="+ Nuevo recordatorio"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/white"
                app:backgroundTint="@color/boop_green"
                app:cornerRadius="20dp"
                app:elevation="8dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
