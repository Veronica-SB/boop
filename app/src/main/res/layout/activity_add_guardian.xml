<?xml version="1.0" encoding="utf-8"?>
<!-- Cuidadores: Añadir cuidador -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_light">

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="24dp" android:paddingEnd="24dp"
        android:paddingTop="18dp" android:paddingBottom="18dp"
        android:background="@color/surface_light">
        <FrameLayout android:id="@+id/btn_back" android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/bg_circle_green_light" android:clickable="true"
            android:focusable="true" android:layout_marginEnd="12dp">
            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                android:layout_gravity="center" android:src="@drawable/ic_arrow_back"
                app:tint="@color/boop_green" />
        </FrameLayout>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Añadir cuidador"
            android:textSize="17sp" android:fontFamily="@font/poppins_bold"
            android:textColor="@color/text_primary_light" />
    </LinearLayout>

    <!-- Body -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="28dp" android:paddingEnd="28dp"
        android:paddingTop="16dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Introduce el email del usuario que quieres añadir como cuidador."
            android:textSize="13sp" android:fontFamily="@font/poppins_regular"
            android:textColor="@color/text_secondary_light"
            android:layout_marginBottom="20dp" android:lineSpacingMultiplier="1.4" />

        <!-- Search row: email + button -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Correo electrónico" android:textSize="13sp"
            android:fontFamily="@font/poppins_semibold" android:textColor="@color/text_primary_light"
            android:layout_marginBottom="8dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="10dp"
                app:boxCornerRadiusBottomEnd="12dp" app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/border_light" app:boxBackgroundColor="@color/background_light"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_search_guardian_email"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:hint="usuario@email.com" android:fontFamily="@font/poppins_regular"
                    android:textSize="14sp" android:inputType="textEmailAddress"
                    android:textColor="@color/text_primary_light" android:imeOptions="actionSearch" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_search_user"
                android:layout_width="wrap_content" android:layout_height="56dp"
                android:text="Buscar" android:textSize="13sp"
                android:fontFamily="@font/poppins_bold" android:textColor="@color/white"
                app:backgroundTint="@color/boop_green" app:cornerRadius="14dp" />
        </LinearLayout>

        <!-- Search result preview (visible after search) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_search_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/boop_green_light">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:padding="16dp">
                <!-- Avatar -->
                <FrameLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/bg_circle_green_light" android:layout_marginEnd="12dp">
                    <TextView android:id="@+id/tv_result_avatar" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_gravity="center"
                        android:text="🧑" android:textSize="20sp" />
                </FrameLayout>
                <!-- Name + email -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tv_result_name" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Nombre del usuario"
                        android:textSize="14sp" android:fontFamily="@font/poppins_semibold"
                        android:textColor="@color/text_primary_light" />
                    <TextView android:id="@+id/tv_result_email" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="email@email.com"
                        android:textSize="12sp" android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/text_secondary_light" android:layout_marginTop="2dp" />
                </LinearLayout>
                <!-- Verified badge -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Usuario BOOP ✓" android:textSize="10sp"
                    android:fontFamily="@font/poppins_semibold" android:textColor="@color/boop_green_dark"
                    android:background="@drawable/bg_pill_green_light"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="4dp" android:paddingBottom="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- No result message (visible if not found) -->
        <TextView android:id="@+id/tv_no_result" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="No se encontró ningún usuario con ese email."
            android:textSize="13sp" android:fontFamily="@font/poppins_regular"
            android:textColor="@color/alert_red" android:gravity="center"
            android:layout_marginBottom="20dp" android:visibility="gone" />

        <!-- Confirm button -->
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_add_guardian"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:text="Añadir como cuidador" android:textSize="15sp"
            android:fontFamily="@font/poppins_bold" android:textColor="@color/white"
            app:backgroundTint="@color/boop_green" app:cornerRadius="20dp" app:elevation="6dp"
            android:enabled="false" />

        <!-- Info text -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="💡 Los cuidadores pueden ver el perfil de la mascota, sus recordatorios e historial médico, pero no pueden editarlos."
            android:textSize="12sp" android:fontFamily="@font/poppins_regular"
            android:textColor="@color/text_secondary_light"
            android:layout_marginTop="16dp" android:lineSpacingMultiplier="1.4"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>
