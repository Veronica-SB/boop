# ============================================================
#  BOOP — .gitignore
#  Ficheros que NUNCA deben subirse a GitHub
# ============================================================

# ── Secretos y claves ────────────────────────────────────────
local.properties
app/google-services.json
google-services.json
*.keystore
*.jks
keystore.properties

# ── Build outputs ────────────────────────────────────────────
/build
app/build
**/build/

# ── Gradle ───────────────────────────────────────────────────
.gradle
gradle-app.setting
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# ── Android Studio / IntelliJ ────────────────────────────────
*.iml
.idea/
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml

# ── Sistema operativo ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Capturas y logs ──────────────────────────────────────────
/captures
*.log

# ── NDK / CMake ──────────────────────────────────────────────
.externalNativeBuild
.cxx

